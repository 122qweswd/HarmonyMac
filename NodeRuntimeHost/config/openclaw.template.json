{
  "gateway": { "mode": "local", "port": 18800, "auth": { "mode": "none" } },
  "agents": {
    "defaults": {
      "model": { "primary": "aajax/gpt-5.6-luna" },
      "models": {
        "aajax/gpt-5.6-luna": { "params": { "streaming": false } }
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "aajax": {
        "baseUrl": "https://api.aip.aajax.top:20443",
        "apiKey": "${ANTHROPIC_AUTH_TOKEN}",
        "api": "anthropic-messages",
        "models": [
          {
            "id": "gpt-5.6-luna",
            "name": "GPT 5.6 Luna",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "plugins": {
    "entries": {
      "a2a-gateway": {
        "enabled": true,
        "config": {
          "server": { "host": "127.0.0.1", "port": 18810 },
          "agentCard": {
            "name": "MutualInfectionMac",
            "description": "harmonymac A2A node",
            "skills": [
              { "id": "chat", "name": "chat", "description": "chat bridge" }
            ]
          },
          "security": { "inboundAuth": "none" }
        }
      }
    }
  }
}
