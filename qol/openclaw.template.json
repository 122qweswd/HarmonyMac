{
  "diagnostics": {
    "cacheTrace": {
      "enabled": true,
      "filePath": "/Users/{USE-YOUR-USERNAME}/Library/Containers/com.HarmonyOSInterconnection.app/Data/Library/Application Support/MutualInfectionMac/NodeRuntime/state/logs/cache-trace.jsonl",
      "includeMessages": true,
      "includePrompt": true,
      "includeSystem": true
    }
  },
  "gateway": {
    "mode": "local",
    "port": 18800,
    "auth": {
      "mode": "none"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "relay/gpt-5.6-terra"
      },
      "maxConcurrent": 4,
      "timeoutSeconds": 600
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "relay": {
        "baseUrl": "Use-real-api",
        "apiKey": "Use-real-key",
        "api": "openai-completions",
        "models": [
          {
            "id": "gpt-5.6-terra",
            "name": "GPT 5.6 Terra",
            "reasoning": false,
            "input": [
              "text"
            ],
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "plugins": {
    "entries": {
      "a2a-gateway": {
        "enabled": true,
        "config": {
          "server": {
            "host": "127.0.0.1",
            "port": 18810
          },
          "agentCard": {
            "name": "MutualInfectionMac",
            "description": "harmonymac A2A node",
            "skills": [
              {
                "id": "chat",
                "name": "chat",
                "description": "chat bridge"
              }
            ]
          },
          "security": {
            "inboundAuth": "none"
          }
        }
      },
      "fuzzy-search": {
        "enabled": true,
        "config": {
          "enabled": true,
          "toolPath": "${FUZZY_SEARCH_TOOL_PATH}",
          "rootPath": "/Users/mac/Desktop/",
          "timeoutMs": 300000
        }
      }
    }
  }
}
